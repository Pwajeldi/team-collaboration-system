{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "YourAppNamespace.Services.PaymentService": "Debug"
    },
    "Console": {
      "LogLevel": {
        "Default": "Debug",
        "System": "Error"
      },
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "http://localhost:5173",
    "CalendarPath": "/calendar",
    "LoginPath": "/login"
  }
}
